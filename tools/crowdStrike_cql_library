CrowdStrike Falcon NG-SIEM (Advanced Event Search) Triaging Suspicious DNS query alerts - CQL Library

//1 Find Suspicious DNS requests by suffix + length (get ContextProcessId)
#event_simpleName=DnsRequest
| DomainName=/nsdns\.eu$/i
| length(field=DomainName, as=qlen)
| qlen > 150
| table([@timestamp, aid, ComputerName, UserName, DomainName, qlen, ContextProcessId])
| sort(@timestamp, order=desc)

//2 Extract ContextBaseFileName from raw text (when it appears only in metadata/rawstring)
#event_simpleName=DnsRequest
| aid="REPLACE_AID"
| DomainName=/nsdns\.eu$/i
| length(field=DomainName, as=qlen)
| qlen > 150
| regex("ContextBaseFileName=(?<ContextBaseFileName>[^\\s]+)", field=@rawstring)
| table([@timestamp, ComputerName, DomainName, qlen, ContextProcessId, ContextBaseFileName])
| sort(@timestamp, order=desc)

//3 Attribute DNSRequest --> ProcessRollup2 (good pivot point & correlation)
#event_simpleName=DnsRequest
| aid="REPLACE_AID"
| DomainName=/nsdns\.eu$/i
| length(field=DomainName, as=qlen)
| qlen > 150
| join(
    {#event_simpleName=ProcessRollup2 aid="REPLACE_AID"},
    field=ContextProcessId,
    key=TargetProcessId,
    include=[ImageFileName, CommandLine, ParentBaseFileName, SHA256HashData, UserName]
  )
| table([@timestamp, ComputerName, UserName, DomainName, qlen, ContextProcessId,
         ImageFileName, CommandLine, ParentBaseFileName, SHA256HashData])
| sort(@timestamp, order=desc)


//3B if join doesn't populate due to type mismatch
#event_simpleName=DnsRequest
| aid="REPLACE_AID"
| DomainName=/nsdns\.eu$/i
| length(field=DomainName, as=qlen)
| qlen > 150
| pid := format("%s", field=ContextProcessId)
| join(
    {#event_simpleName=ProcessRollup2 aid="REPLACE_AID" | pid := format("%s", field=TargetProcessId)},
    field=pid,
    key=pid,
    include=[ImageFileName, CommandLine, ParentBaseFileName, SHA256HashData, UserName]
  )
| table([@timestamp, ComputerName, UserName, DomainName, qlen, ContextProcessId,
         ImageFileName, CommandLine, ParentBaseFileName, SHA256HashData])
| sort(@timestamp, order=desc)


//4 Pull ProcessRollup2 directly by ProcessIDs
#event_simpleName=ProcessRollup2
| aid="REPLACE_AID"
| in(field="TargetProcessId", values=["7622489416252","7602184006624"])
| table([@timestamp, ComputerName, UserName, TargetProcessId, ImageFileName, CommandLine, ParentBaseFileName, SHA256HashData])
| sort(@timestamp, order=desc)

//5 Scope check: who else is hitting the suffix (environment-wide)
#event_simpleName=DnsRequest
| DomainName=/nsdns\.eu$/i
| length(field=DomainName, as=qlen)
| qlen > 150
| groupBy([ComputerName], function=count())
| sort(_count, order=desc)




//6 Baseline suspicious Edge flag (optional sanity check)
#event_simpleName=ProcessRollup2
| ImageFileName=/\\msedge\.exe$/i
| CommandLine=/--utility-sub-type=network\.mojom\.NetworkService/i
| CommandLine=/--service-sandbox-type=none/i
| groupBy([ComputerName], function=count())
| sort(_count, order=desc)


